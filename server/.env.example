# PostgreSQL settings for Django
POSTGRES_DB=itc_resource_portal
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Django core settings
# Generate a real secret for staging/production, e.g.:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# The deployed frontend origin (a single URL, no commas). Used for where
# SSO redirects users back to after login.
FRONTEND_URL=http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Only needed if the frontend and backend are on different subdomains of
# the same parent domain in production, e.g. resource.example.org and
# backendresource.example.org - set this to ".example.org" (leading dot)
# so the browser shares the session/csrf cookies between them. Leave unset
# for local dev.
COOKIE_DOMAIN=

# ITC SSO (https://sso.tech-iitb.org/docs/)
SSO_BASE_URL=https://sso.tech-iitb.org
SSO_PROJECT_ID=38da6e30-2b15-43f2-bdf7-41c8e9d12583
